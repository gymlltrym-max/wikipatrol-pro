{
  "manifest_version": 3,
  "name": "WikiPatrol Live Pro",
  "version": "2.1.1",
  "description": "ניטור בזמן אמת של עריכות בויקיפדיה pro",
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "alarms",
    "cookies" 
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://stream.wikimedia.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "פתח ניטור ויקיפדיה"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}